---
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '@fontsource/jetbrains-mono/700.css';
import '@fontsource/jetbrains-mono/800.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/600-italic.css';
import '@fontsource/inter-tight/400.css';
import '@fontsource/inter-tight/500.css';
import Lanyard from '../components/Lanyard';
import { SITES, CLOCK } from '../config';

const title = 'Airu — Software Engineer & Photographer';
const description = 'Rizky "Airu" Khairullah. Backend engineer by day, street and travel photographer in Tokyo. Two passes, one person.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://byairu.com/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://byairu.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#f4f3f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141518" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Decide early whether the 3D card will run, so the static fallback never flashes.
      (function () {
        try {
          var c = document.createElement('canvas');
          var gl = c.getContext('webgl2') || c.getContext('webgl');
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (gl && !reduce) document.documentElement.classList.add('will-3d');
        } catch (e) {}
      })();
    </script>
    <script is:inline define:vars={{ clock: CLOCK }}>
      // Night by your clock (not the visitor's), and the visitor's saved sound choice, set before
      // the first paint so the page never flashes the wrong colours. ?hour=22 previews an hour.
      (function () {
        var root = document.documentElement;
        try {
          var params = new URLSearchParams(location.search);
          var q = params.get('hour');
          var m = +(params.get('month') || '');
          if (m >= 1 && m <= 12) root.dataset.month = String(m);
          var h = q !== null && q !== '' && !isNaN(+q)
            ? ((+q % 24) + 24) % 24
            : +new Intl.DateTimeFormat('en-GB', { hour: '2-digit', hourCycle: 'h23', timeZone: clock.timeZone }).format(new Date());
          var inside = function (r) { return r[0] > r[1] ? h >= r[0] || h < r[1] : h >= r[0] && h < r[1]; };
          root.dataset.hour = q !== null && q !== '' ? String(h) : '';
          if (inside(clock.night)) root.classList.add('night');
          if (inside(clock.torch)) root.classList.add('torch');
        } catch (e) {}
        try { if (localStorage.getItem('sound') === 'on') root.dataset.sound = 'on'; } catch (e) {}
      })();
    </script>
    <style is:global>
      :root {
        --bg: #f4f3f0;
        --fg: #1d1e22;
        --muted: #8a8c92;
        --mono: 'JetBrains Mono', ui-monospace, Menlo, monospace;
        --serif: 'Cormorant Garamond', Georgia, serif;
        --sans: 'Inter Tight', 'Helvetica Neue', Arial, sans-serif;
      }
      @media (prefers-color-scheme: dark) {
        :root { --bg: #141518; --fg: #ececea; --muted: #7d8087; color-scheme: dark; }
      }
      /* after hours where Airu is: the room goes dark and the cursor is a flashlight */
      html.night { --bg: #0d0f14; --fg: #e9e6df; --muted: #6c7079; color-scheme: dark; }
      * { box-sizing: border-box; }
      html, body { margin: 0; height: 100%; }
      body { background: var(--bg); color: var(--fg); font-family: var(--mono); overflow: hidden; }
      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0; }
      main { position: relative; height: 100dvh; }
      .scene { position: absolute; inset: 0; }
      /* a quick fade as the first frame lands; the card itself drops in from above */
      .scene canvas { opacity: 0; transition: opacity .35s ease; }
      html.has-3d .scene canvas { opacity: 1; }

      .links {
        position: absolute; left: 0; right: 0; bottom: max(24px, env(safe-area-inset-bottom));
        display: flex; justify-content: center; flex-wrap: wrap; gap: 8px 22px;
        padding-inline: 16px; font-size: 12px; z-index: 2;
      }
      .links a { color: var(--muted); text-decoration: none; padding-bottom: 3px; border-bottom: 1px solid transparent; transition: color .35s, border-color .35s; }
      .links a.on, .links a:hover { color: var(--fg); border-color: var(--fg); }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--fg); outline-offset: 4px; }

      /* corner bits: the clock where Airu is, and the sound switch */
      .corner {
        position: absolute; top: max(16px, env(safe-area-inset-top)); z-index: 2;
        font: 500 11px/1 var(--mono); color: var(--muted); letter-spacing: .02em;
      }
      .clock { left: 16px; margin-top: -6px; }
      /* the whole line is one button: the sky right now, the time, and a small chevron */
      .sky-btn {
        display: flex; align-items: center; gap: 8px; margin-left: -6px; padding: 4px 10px 4px 4px;
        font: inherit; color: var(--muted); cursor: pointer; background: none;
        border: 1px solid transparent; border-radius: 999px;
        transition: color .2s, background .2s, border-color .2s;
      }
      .sky-btn .disc {
        display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%;
        border: 1px solid color-mix(in srgb, var(--fg) 16%, transparent);
        background: color-mix(in srgb, var(--fg) 3%, transparent);
      }
      .sky-btn svg { width: 14px; height: 14px; overflow: visible; }
      .sky-btn .chev { width: 8px; height: 8px; opacity: .55; transition: transform .25s, opacity .2s; }
      .sky-btn:hover, .sky-btn[aria-expanded="true"] {
        color: var(--fg);
        background: color-mix(in srgb, var(--fg) 5%, transparent);
        border-color: color-mix(in srgb, var(--fg) 14%, transparent);
      }
      .sky-btn:hover .chev { opacity: 1; transform: translateY(1px); }
      .sky-btn[aria-expanded="true"] .chev { opacity: 1; transform: rotate(180deg); }
      .sky-btn [data-sky] { display: none; }
      .sky-btn[data-now="day"] [data-sky="day"], .sky-btn[data-now="low"] [data-sky="low"], .sky-btn[data-now="night"] [data-sky="night"] { display: block; }
      /* a little life: the sun turns, the stars twinkle, and one hop once the card has landed */
      @media (prefers-reduced-motion: no-preference) {
        .sky-btn .rays { transform-origin: 8px 8px; animation: spin 24s linear infinite; }
        .sky-btn .twinkle { animation: twinkle 2.4s ease-in-out infinite; }
        .sky-btn .twinkle + .twinkle { animation-delay: 1.2s; }
        html.has-3d .sky-btn .disc { animation: hop .7s cubic-bezier(.3,1.6,.5,1) 1.4s both; }
        .sky-btn:hover svg { transform: scale(1.12); transition: transform .25s; }
      }
      @keyframes spin { to { transform: rotate(360deg); } }
      @keyframes twinkle { 50% { opacity: .2; } }
      @keyframes hop { 0%, 100% { transform: none; } 40% { transform: translateY(-4px) scale(1.06); } }
      /* the time / season picker under the clock */
      .time-panel {
        position: absolute; top: 34px; left: -6px; width: max-content; max-width: calc(100vw - 16px);
        padding: 12px 12px 6px; border-radius: 10px; background: var(--bg);
        border: 1px solid color-mix(in srgb, var(--fg) 12%, transparent);
        box-shadow: 0 10px 30px rgba(0,0,0,.12);
      }
      .time-panel[hidden] { display: none; }
      .time-panel p { margin: 0 0 6px; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; }
      .time-panel output { margin-left: 6px; color: var(--fg); letter-spacing: 0; }
      .time-row { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; width: 300px; max-width: calc(100vw - 40px); }
      /* the track is the sky over a day in Tokyo, stops on the same hours as the street (src/lib/scene.ts):
         night to 04, dawn 04–06, morning 06–09, day 09–16, golden 16–18, dusk 18–20, night from 20 */
      #time-range {
        flex: 1; min-width: 0; height: 18px; margin: 0; background: none; cursor: pointer;
        -webkit-appearance: none; appearance: none;
      }
      #time-range::-webkit-slider-runnable-track {
        height: 6px; border-radius: 999px;
        background: linear-gradient(90deg, #10183a 0%, #10183a 16.7%, #d898a8 20.8%, #9fd0f4 31%, #6fb5ee 45%, #6fb5ee 66.7%, #f2bd7a 70.8%, #a8577a 79.2%, #10183a 83.3%, #10183a 100%);
      }
      #time-range::-moz-range-track {
        height: 6px; border-radius: 999px;
        background: linear-gradient(90deg, #10183a 0%, #10183a 16.7%, #d898a8 20.8%, #9fd0f4 31%, #6fb5ee 45%, #6fb5ee 66.7%, #f2bd7a 70.8%, #a8577a 79.2%, #10183a 83.3%, #10183a 100%);
      }
      #time-range::-webkit-slider-thumb {
        -webkit-appearance: none; width: 16px; height: 16px; margin-top: -5px; border-radius: 50%;
        background: var(--bg); border: 2px solid var(--fg); box-shadow: 0 1px 4px rgba(0,0,0,.25);
      }
      #time-range::-moz-range-thumb { width: 12px; height: 12px; border-radius: 50%; background: var(--bg); border: 2px solid var(--fg); }
      #time-range:focus-visible { outline: 2px solid var(--fg); outline-offset: 3px; border-radius: 4px; }
      .reset {
        font: 500 11px/1 var(--mono); color: var(--muted); background: none; border: 0; padding: 4px 0;
        cursor: pointer; white-space: nowrap; transition: color .2s;
      }
      .reset:hover, .reset[aria-pressed="true"] { color: var(--fg); }
      .reset[aria-pressed="true"] { cursor: default; }
      .seasons { display: flex; gap: 6px; margin-bottom: 10px; }
      .seasons button {
        display: grid; place-items: center; width: 38px; height: 34px; padding: 0; cursor: pointer;
        font: 500 10px/1 var(--mono); color: var(--muted); background: none;
        border: 1px solid transparent; border-radius: 8px; transition: background .2s, border-color .2s, color .2s;
      }
      .seasons button svg { width: 18px; height: 18px; transition: transform .2s; }
      .seasons button:hover { background: color-mix(in srgb, var(--fg) 6%, transparent); color: var(--fg); }
      .seasons button:hover svg { transform: scale(1.1); }
      .seasons button[aria-pressed="true"] {
        background: color-mix(in srgb, var(--fg) 9%, transparent);
        border-color: color-mix(in srgb, var(--fg) 35%, transparent); color: var(--fg);
      }
      .sound { right: 16px; background: none; border: 0; padding: 0; cursor: pointer; transition: color .25s; }
      .sound:hover, .sound[aria-pressed="true"] { color: var(--fg); }

      /* static fallback (no WebGL or reduced motion): both cards side by side */
      .fallback { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; gap: 20px; padding: 24px 16px 80px; flex-wrap: wrap; overflow-y: auto; }
      html.will-3d .fallback { display: none; }
      .fb { width: 212px; height: 316px; border-radius: 8px; overflow: hidden; text-decoration: none; display: flex; flex-direction: column; box-shadow: 0 0 0 10px #16171b, 0 20px 36px rgba(0,0,0,.25); }
      .fb-dev { background: #fff linear-gradient(#e2e8f0 1px, transparent 1px) 0 0 / 12px 12px; color: #0f172a; font-family: var(--mono); }
      .fb-dev .t { padding: 14px 12px 0; font-weight: 800; }
      .fb-dev .t i { font-style: normal; color: #e9aa18; }
      .fb-dev .n { padding: 0 12px; margin-top: auto; font-weight: 800; font-size: 16px; line-height: 1.2; }
      .fb-dev .b { margin-top: 14px; background: #e9aa18; border-top: 2px solid #0f172a; padding: 9px 12px 10px; font-size: 13px; font-weight: 800; }
      .fb-dev .b span { display: block; font-size: 10px; font-weight: 500; }
      .fb-frame { background: #0b0b0b; color: #f5f5f4; }
      .fb-frame .p { order: -1; height: 208px; background: #d6d1c9 url(/avatar/airu-camera.webp) center 12px / 102% auto no-repeat; filter: grayscale(1); }
      .fb-frame .n { padding: 6px 10px 0; font-family: var(--serif); font-size: 44px; line-height: 1; }
      .fb-frame .r { padding: 2px 13px 0; font-family: var(--sans); font-size: 7px; letter-spacing: .3em; color: #a3a3a3; }
    </style>
  </head>
  <body>
    <main>
      <h1 class="sr-only">Rizky "Airu" Khairullah — software engineer and photographer</h1>
      <div class="scene">
        <Lanyard client:only="react" />
        <div class="fallback">
          <a class="fb fb-dev" href={SITES.dev.url}>
            <span class="t">AIRU<i>.</i></span>
            <span class="n">RIZKY<br />KHAIRULLAH</span>
            <span class="b">SOFTWARE ENGINEER<span>{SITES.dev.host}</span></span>
          </a>
          <a class="fb fb-frame" href={SITES.frame.url}>
            <span class="n">Airu.</span>
            <span class="r">PHOTOGRAPHER</span>
            <span class="p" aria-hidden="true"></span>
          </a>
        </div>
      </div>
      <div class="corner clock">
        <button class="sky-btn" id="clock-btn" type="button" aria-expanded="false" aria-controls="time-panel" aria-label="Time in Tokyo. Change the time of day and season">
          <span class="disc" aria-hidden="true">
            <svg data-sky="day" viewBox="0 0 16 16"><g class="rays" stroke="#e9a23b" stroke-width="1.4" stroke-linecap="round">{[0, 45, 90, 135, 180, 225, 270, 315].map((a) => <line x1={8 + 5 * Math.cos((a * Math.PI) / 180)} y1={8 + 5 * Math.sin((a * Math.PI) / 180)} x2={8 + 6.8 * Math.cos((a * Math.PI) / 180)} y2={8 + 6.8 * Math.sin((a * Math.PI) / 180)} />)}</g><circle cx="8" cy="8" r="3.2" fill="#f2b13e" /></svg>
            <svg data-sky="low" viewBox="0 0 16 16"><path d="M3.5 11a4.5 4.5 0 0 1 9 0z" fill="#ef8f4a" /><g class="twinkle" stroke="#ef8f4a" stroke-width="1.3" stroke-linecap="round"><path d="M8 3.2v1.4M2.9 5.6l1 1M13.1 5.6l-1 1" /></g><path d="M1.5 11.5h13" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /></svg>
            <svg data-sky="night" viewBox="0 0 16 16"><path d="M10.8 2.2a6 6 0 1 0 3 9.6A5 5 0 0 1 10.8 2.2z" fill="#c7b46a" /><circle class="twinkle" cx="4" cy="4" r=".8" fill="currentColor" /><circle class="twinkle" cx="6.5" cy="1.8" r=".55" fill="currentColor" /></svg>
          </span>
          <span id="clock"></span>
          <svg class="chev" viewBox="0 0 8 8" aria-hidden="true"><path d="M1 2.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <div class="time-panel" id="time-panel" hidden>
          <p>time of day <output id="time-val" for="time-range"></output></p>
          <div class="time-row">
            <input type="range" id="time-range" min="0" max="1435" step="5" aria-label="Time of day in Tokyo" />
            <button type="button" class="reset" id="time-now">↺ now</button>
          </div>
          <p>season <output id="season-val"></output></p>
          <div class="seasons" role="group" aria-label="Season">
            <button type="button" data-v="" aria-label="Season now" title="now">auto</button>
            <button type="button" data-v="4" aria-label="Spring" title="spring">
              <svg viewBox="0 0 16 16" aria-hidden="true"><g fill="#f29ab3">{[0, 72, 144, 216, 288].map((a) => <circle cx={8 + 4 * Math.sin((a * Math.PI) / 180)} cy={8.4 - 4 * Math.cos((a * Math.PI) / 180)} r="3.1" />)}</g><circle cx="8" cy="8.4" r="1.7" fill="#ffd36b" /></svg>
            </button>
            <button type="button" data-v="8" aria-label="Summer" title="summer">
              <svg viewBox="0 0 16 16" aria-hidden="true"><g stroke="#f2a93b" stroke-width="1.4" stroke-linecap="round">{[0, 45, 90, 135, 180, 225, 270, 315].map((a) => <line x1={8 + 5.2 * Math.cos((a * Math.PI) / 180)} y1={8 + 5.2 * Math.sin((a * Math.PI) / 180)} x2={8 + 6.8 * Math.cos((a * Math.PI) / 180)} y2={8 + 6.8 * Math.sin((a * Math.PI) / 180)} />)}</g><circle cx="8" cy="8" r="3.4" fill="#f6b73c" /></svg>
            </button>
            <button type="button" data-v="11" aria-label="Autumn" title="autumn">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="#e2622b" d="M8 1l1.5 3.4L13 3.5l-1.4 3.4L15 8l-3.4 1.4 1 2.6-3.6-1.1-.2 4.1H7.2l-.2-4.1L3.4 12l1-2.6L1 8l3.4-1.1L3 3.5l3.5.9z" /></svg>
            </button>
            <button type="button" data-v="1" aria-label="Winter" title="winter">
              <svg viewBox="0 0 16 16" aria-hidden="true"><g stroke="#7fb3e3" stroke-width="1.3" stroke-linecap="round" fill="none">{[0, 60, 120].map((a) => <g transform={`rotate(${a} 8 8)`}><path d="M8 1.5v13" /><path d="M6.2 3.2L8 4.8l1.8-1.6M6.2 12.8L8 11.2l1.8 1.6" /></g>)}</g></svg>
            </button>
          </div>
        </div>
      </div>
      <button class="corner sound" id="sound" type="button" aria-pressed="false">sound off</button>
      <nav class="links" aria-label="Portfolios">
        <a id="l-dev" class="on" href={SITES.dev.url}>{SITES.dev.host} ↗</a>
        <a id="l-frame" href={SITES.frame.url}>{SITES.frame.host} ↗</a>
      </nav>
    </main>

    <script>
      import { CLOCK } from '../config';
      import { unlockAudio, play } from '../lib/sfx';
      import { phaseOf, seasonOf } from '../lib/scene';

      // ---- clock: the time where Airu is, the city and the season (both follow the picker) ----
      const root = document.documentElement;
      const clockEl = document.getElementById('clock')!;
      const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hourCycle: 'h23', timeZone: CLOCK.timeZone });
      const tick = () => {
        let time = fmt.format(new Date());
        if (pick.minutes !== null) time = hhmm(pick.minutes); // a picked time of day
        clockEl.textContent = `${time} ${CLOCK.city} · ${seasonOf(pick.month ? +pick.month : realMonth())}`;
      };

      // ---- time / season picker: the visitor can see the card at another hour or season ----
      const inside = (h: number, [a, b]: readonly number[]) => (a > b ? h >= a || h < b : h >= a && h < b);
      const realMinutes = () => {
        const [h, m] = fmt.format(new Date()).split(':').map(Number);
        return h * 60 + m;
      };
      const hhmm = (min: number) => `${String(Math.floor(min / 60)).padStart(2, '0')}:${String(min % 60).padStart(2, '0')}`;
      // null / '' = now; ?hour= and ?month= in the URL start the page at a picked time
      const pick: { minutes: number | null; month: string } = {
        minutes: root.dataset.hour ? +root.dataset.hour * 60 : null,
        month: root.dataset.month || '',
      };
      const btn = document.getElementById('clock-btn')!;
      const panel = document.getElementById('time-panel')!;
      const range = document.getElementById('time-range') as HTMLInputElement;
      const timeVal = document.getElementById('time-val')!;
      const nowBtn = document.getElementById('time-now')!;
      const chips = panel.querySelectorAll<HTMLButtonElement>('.seasons button');
      const seasonVal = document.getElementById('season-val')!;
      const realMonth = () => +new Intl.DateTimeFormat('en-GB', { month: 'numeric', timeZone: CLOCK.timeZone }).format(new Date());
      let shown = ''; // the hour and month the card was last drawn for

      function apply(announce: boolean) {
        const minutes = pick.minutes ?? realMinutes();
        const h = Math.floor(minutes / 60);
        if (pick.minutes !== null) root.dataset.hour = String(h);
        else delete root.dataset.hour;
        if (pick.month) root.dataset.month = pick.month;
        else delete root.dataset.month;
        root.classList.toggle('night', inside(h, CLOCK.night));
        root.classList.toggle('torch', inside(h, CLOCK.torch));
        range.value = String(minutes);
        timeVal.textContent = hhmm(minutes);
        nowBtn.setAttribute('aria-pressed', String(pick.minutes === null));
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.v === pick.month)));
        seasonVal.textContent = pick.month ? seasonOf(+pick.month) : `${seasonOf(realMonth())} · now`;
        const phase = phaseOf(h);
        btn.dataset.now = phase === 'night' ? 'night' : phase === 'day' || phase === 'morning' ? 'day' : 'low';
        tick();
        // the street only changes by the hour, so only redraw the card when the hour or month does
        const key = `${h}/${pick.month}`;
        if (announce && key !== shown) window.dispatchEvent(new CustomEvent('lanyard:time'));
        shown = key;
      }
      apply(false);
      range.addEventListener('input', () => {
        pick.minutes = +range.value;
        apply(true);
      });
      nowBtn.addEventListener('click', () => {
        pick.minutes = null;
        apply(true);
      });
      // keep up with the real clock: the time shown moves on, and when the hour turns the sky and
      // lights follow (apply only redraws the card when the hour actually changed)
      setInterval(() => apply(pick.minutes === null), 20_000);

      const open = (on: boolean) => {
        panel.hidden = !on;
        btn.setAttribute('aria-expanded', String(on));
      };
      btn.addEventListener('click', () => open(panel.hidden));
      chips.forEach((c) =>
        c.addEventListener('click', () => {
          if (pick.month === c.dataset.v) return;
          pick.month = c.dataset.v!;
          apply(true);
        }),
      );
      document.addEventListener('pointerdown', (e) => {
        if (!panel.hidden && !(e.target as Element).closest('.clock')) open(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !panel.hidden) {
          open(false);
          btn.focus();
        }
      });

      // ---- sound switch (off by default, remembered per visitor) ----
      const soundBtn = document.getElementById('sound')!;
      const showSound = () => {
        const on = root.dataset.sound === 'on';
        soundBtn.textContent = on ? 'sound on' : 'sound off';
        soundBtn.setAttribute('aria-pressed', String(on));
      };
      showSound();
      soundBtn.addEventListener('click', () => {
        const on = root.dataset.sound !== 'on';
        if (on) root.dataset.sound = 'on';
        else delete root.dataset.sound;
        try { localStorage.setItem('sound', on ? 'on' : 'off'); } catch {}
        if (on) {
          unlockAudio();
          play('grab');
        }
        showSound();
      });
      // a saved "on" still needs one tap somewhere before the browser allows audio
      window.addEventListener('pointerdown', () => root.dataset.sound === 'on' && unlockAudio(), { once: true });

      const links = { dev: document.getElementById('l-dev')!, frame: document.getElementById('l-frame')! };
      window.addEventListener('lanyard:side', (e) => {
        const side = (e as CustomEvent<'dev' | 'frame'>).detail;
        links.dev.classList.toggle('on', side === 'dev');
        links.frame.classList.toggle('on', side === 'frame');
      });
      // hovering a link turns the card to that side
      (['dev', 'frame'] as const).forEach((s) =>
        links[s].addEventListener('pointerenter', () => window.dispatchEvent(new CustomEvent('lanyard:set', { detail: s }))),
      );
    </script>
  </body>
</html>
